<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonia="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        x:Class="Project.Launch.Views.MainWindow"
        Title="Kilim Minecraft Launcher"
        Width="960" Height="560"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur"
        avalonia:Win32Properties.WindowCornerPreference="Round">

    <Grid Background="#CCFFFFFF">
        <Border x:Name="Overlay"
                Background="#80000000"
                IsVisible="False"
                Grid.RowSpan="2"/>

        <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0"
                x:Name="TitleBarBorder"
                PointerPressed="TitleBar_PointerPressed"
                CornerRadius="12,12,0,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#CCFF6B9D" Offset="0.0"/>
                    <GradientStop Color="#CCB366FF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="*, Auto, Auto">
                <TextBlock Grid.Column="0"
                           x:Name="TitleText"
                           Text="Kilim Minecraft Launcher"
                           FontSize="16"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />
                <Button Grid.Column="1"
                        x:Name="MinimizeButton"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="45" Height="35"
                        Cursor="Hand">
                    <Image x:Name="MinimizeImage"
                           Source="avares://Project.Launch/src/Views/imgs/black-.png"
                           Width="20" Height="26" Stretch="Fill"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
                <Button Grid.Column="2"
                        x:Name="CloseButton"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="45" Height="35"
                        Cursor="Hand"
                        Margin="0,0,10,0">
                    <Image x:Name="CloseImage"
                           Source="avares://Project.Launch/src/Views/imgs/blackx.png"
                           Width="20" Height="20" Stretch="Uniform"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1"
              Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6">

                <!-- 头像容器 -->
                <Grid Width="180" Height="180"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center">
                    <Image x:Name="FaceImage"
                           Stretch="Uniform"
                           Width="120" Height="120"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapInterpolationMode="None" />
                    <Image x:Name="HatImage"
                           Stretch="Uniform"
                           Width="120" Height="120"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="-3,-3,-3,-3"
                           RenderOptions.BitmapInterpolationMode="None" />
                    <Border Width="120" Height="120"
                            BorderBrush="#DDD"
                            BorderThickness="2"
                            CornerRadius="4"
                            IsHitTestVisible="False"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center" />
                </Grid>

                <TextBlock x:Name="SkinStatusText"
                           Text="未登录"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#333"
                           HorizontalAlignment="Center" />

            </StackPanel>
        </Grid>
    </Grid>
</Window>