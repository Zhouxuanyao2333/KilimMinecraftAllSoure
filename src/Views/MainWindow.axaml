<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonia="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        x:Class="Project.Launch.Views.MainWindow"
        Title="KilimMinecraftLauncherDemo"
        Width="960" Height="560"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur"
        avalonia:Win32Properties.WindowCornerPreference="Round">

    <Grid Background="#AAFFFFFF">
        <Border x:Name="Overlay"
                Background="#80000000"
                IsVisible="False"
                Grid.RowSpan="2"/>

        <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ★ 标题栏 -->
        <Border Grid.Row="0"
                x:Name="TitleBarBorder"
                PointerPressed="TitleBar_PointerPressed"
                CornerRadius="12,12,0,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#CCFF6B9D" Offset="0.0"/>
                    <GradientStop Color="#CCB366FF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Transitions>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.4" />
                </Transitions>
            </Border.Transitions>

            <Grid ColumnDefinitions="*, Auto, Auto">
                <TextBlock Grid.Column="0"
                           x:Name="TitleText"
                           Text="KilimMinecraftLauncherDemo"
                           FontSize="16"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0">
                    <TextBlock.Transitions>
                        <Transitions>
                            <BrushTransition Property="Foreground" Duration="0:0:0.4" />
                        </Transitions>
                    </TextBlock.Transitions>
                </TextBlock>

                <Button Grid.Column="1"
                        x:Name="MinimizeButton"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="45" Height="35"
                        Cursor="Hand">
                    <Image x:Name="MinimizeImage"
                           Source="avares://Project.Launch/src/Views/imgs/white-.png"
                           Width="20" Height="26" Stretch="Fill"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Opacity="1">
                        <Image.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                            </Transitions>
                        </Image.Transitions>
                    </Image>
                </Button>

                <Button Grid.Column="2"
                        x:Name="CloseButton"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="45" Height="35"
                        Cursor="Hand"
                        Margin="0,0,10,0">
                    <Image x:Name="CloseImage"
                           Source="avares://Project.Launch/src/Views/imgs/whitex.png"
                           Width="20" Height="20" Stretch="Uniform"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Opacity="1">
                        <Image.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                            </Transitions>
                        </Image.Transitions>
                    </Image>
                </Button>
            </Grid>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">

                <!-- 头像 -->
                <Grid Width="180" Height="180"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center">
                    <Image x:Name="FaceImage"
                           Stretch="Uniform"
                           Width="120" Height="120"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapInterpolationMode="None" />
                    <Image x:Name="HatImage"
                           Stretch="Uniform"
                           Width="120" Height="120"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="-3,-3,-3,-3"
                           RenderOptions.BitmapInterpolationMode="None" />
                    <Border Width="120" Height="120"
                            BorderBrush="#DDD"
                            BorderThickness="2"
                            CornerRadius="4"
                            IsHitTestVisible="False"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center" />
                </Grid>

                <!-- 玩家名字 / 未登录 -->
                <TextBlock x:Name="SkinStatusText"
                           Text="未登录"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#333"
                           HorizontalAlignment="Center" />

                <!-- 按钮组 -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            Margin="0,10,0,0">

                    <!-- 主按钮 -->
                    <Button x:Name="LaunchGameButton"
                            Width="220"
                            Height="80"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            IsVisible="False">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Stretch"
                                                              HorizontalContentAlignment="Stretch"
                                                              VerticalContentAlignment="Stretch" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Styles>
                        <Grid>
                            <Image x:Name="LaunchGameImage"
                                   Source="avares://Project.Launch/src/Views/imgs/button-Start3.png"
                                   Stretch="Fill" />
                            <TextBlock x:Name="LaunchGameText"
                                       Text="导入实例"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- 副按钮 -->
                    <Button x:Name="ExpandButton"
                            Width="45"
                            Height="80"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            IsVisible="False">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Stretch"
                                                              HorizontalContentAlignment="Stretch"
                                                              VerticalContentAlignment="Stretch" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Styles>
                        <Grid>
                            <Image x:Name="ExpandImage"
                                   Source="avares://Project.Launch/src/Views/imgs/button-Start4.png"
                                   Stretch="Fill" />
                            <TextBlock Text="^"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- 未登录：重新登录 -->
                    <Grid x:Name="ReLoginContainer"
                          Width="292" Height="85"
                          IsVisible="False">
                        <Button x:Name="ReLoginButton"
                                Width="275"
                                Height="80"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                IsVisible="False"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Stretch"
                                                                  HorizontalContentAlignment="Stretch"
                                                                  VerticalContentAlignment="Stretch" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Styles>
                            <Grid>
                                <Image Source="avares://Project.Launch/src/Views/imgs/ReLogin.png"
                                       Stretch="Fill"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch" />
                                <TextBlock Text="登录"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 虚拟弹窗 -->
        <Border x:Name="CancelToast"
                Grid.Row="1"
                IsVisible="False"
                Opacity="0"
                Background="#F2FFFFFF"
                CornerRadius="14"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                Padding="20,16"
                MinWidth="360"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,24,24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24"
                                  OffsetX="0"
                                  OffsetY="8"
                                  Color="#33000000" />
            </Border.Effect>
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3">
                        <DoubleTransition.Easing>
                            <CubicEaseInOut />
                        </DoubleTransition.Easing>
                    </DoubleTransition>
                </Transitions>
            </Border.Transitions>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="14">
                <Image Source="avares://Project.Launch/src/Views/imgs/warning.png"
                       Width="28"
                       Height="28"
                       Stretch="Uniform"
                       VerticalAlignment="Center" />
                <TextBlock x:Name="ToastText"
                           Text="用户取消登录"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#333"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>