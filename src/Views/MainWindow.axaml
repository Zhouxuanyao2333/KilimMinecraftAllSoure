<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonia="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        x:Class="Project.Launch.Views.MainWindow"
        Title="Kilim Minecraft Launcher"
        Width="960" Height="560"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur"
        avalonia:Win32Properties.WindowCornerPreference="Round">

    <Grid Background="#AAFFFFFF">
        <Border x:Name="Overlay"
                Background="#80000000"
                IsVisible="False"
                Grid.RowSpan="2"/>

        <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ★ 标题栏：加上 Background 的 BrushTransition -->
        <Border Grid.Row="0"
                x:Name="TitleBarBorder"
                PointerPressed="TitleBar_PointerPressed"
                CornerRadius="12,12,0,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#CCFF6B9D" Offset="0.0"/>
                    <GradientStop Color="#CCB366FF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Transitions>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.4" />
                </Transitions>
            </Border.Transitions>

            <Grid ColumnDefinitions="*, Auto, Auto">
                <!-- ★ 标题文字：加上 Foreground 的 BrushTransition -->
                <TextBlock Grid.Column="0"
                           x:Name="TitleText"
                           Text="Kilim Minecraft Launcher"
                           FontSize="16"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0">
                    <TextBlock.Transitions>
                        <Transitions>
                            <BrushTransition Property="Foreground" Duration="0:0:0.4" />
                        </Transitions>
                    </TextBlock.Transitions>
                </TextBlock>

                <!-- 最小化按钮 -->
                <Button Grid.Column="1"
                        x:Name="MinimizeButton"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="45" Height="35"
                        Cursor="Hand">
                    <Image x:Name="MinimizeImage"
                           Source="avares://Project.Launch/src/Views/imgs/white-.png"
                           Width="20" Height="26" Stretch="Fill"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Opacity="1">
                        <Image.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                            </Transitions>
                        </Image.Transitions>
                    </Image>
                </Button>

                <!-- 关闭按钮 -->
                <Button Grid.Column="2"
                        x:Name="CloseButton"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="45" Height="35"
                        Cursor="Hand"
                        Margin="0,0,10,0">
                    <Image x:Name="CloseImage"
                           Source="avares://Project.Launch/src/Views/imgs/whitex.png"
                           Width="20" Height="20" Stretch="Uniform"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Opacity="1">
                        <Image.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                            </Transitions>
                        </Image.Transitions>
                    </Image>
                </Button>
            </Grid>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">

                <!-- 头像 -->
                <Grid Width="180" Height="180"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center">
                    <Image x:Name="FaceImage"
                           Stretch="Uniform"
                           Width="120" Height="120"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapInterpolationMode="None" />
                    <Image x:Name="HatImage"
                           Stretch="Uniform"
                           Width="120" Height="120"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="-3,-3,-3,-3"
                           RenderOptions.BitmapInterpolationMode="None" />
                    <Border Width="120" Height="120"
                            BorderBrush="#DDD"
                            BorderThickness="2"
                            CornerRadius="4"
                            IsHitTestVisible="False"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center" />
                </Grid>

                <!-- 玩家名字 -->
                <TextBlock x:Name="SkinStatusText"
                           Text="未登录"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#333"
                           HorizontalAlignment="Center" />

                <!-- 两个 Lar-Miret 按钮 -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            Margin="0,10,0,0">
                    <Button x:Name="LaunchGameButton"
                            Classes="LarMiret"
                            Width="220"
                            Height="80">
                        <TextBlock Text="启动游戏" FontSize="24" />
                    </Button>
                    <Button x:Name="ExpandButton"
                            Classes="LarMiret"
                            Width="45"
                            Height="80">
                        <TextBlock Text="^" FontSize="30" />
                    </Button>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Grid>
</Window>